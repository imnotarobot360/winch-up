# Winch Up environment
# Copy to .env.local for development. Every one of these is also set in Vercel
# (Production + Preview) before the first deploy. See README.md for where each value comes from.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin, no trailing slash. Used to build the /r/[token] link that gets texted out,
# so it must be the real public URL, not localhost, in production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Supabase  (Dashboard -> Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_, never import into a client component.
# Bypasses RLS: it is what the dispatch job and the SMS sender use.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project ref, e.g. abcdefghijklmnop (used by the CLI and by the cron job URL)
SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------
# Twilio  (Console -> Account Info)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a messaging service (preferred, required for A2P 10DLC) or a single number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Only needed if the signature check fails behind the proxy. Twilio signs the exact URL it
# posted to; when the host header has been rewritten, the reconstruction is wrong and this pins
# it. Set it to your domain plus /api/twilio/inbound.
#
# There is no separate webhook secret and there never was. The inbound route authenticates with
# Twilio's own HMAC-SHA1 signature over TWILIO_AUTH_TOKEN, which is stronger than a shared
# secret because it covers the body as well as the caller.
TWILIO_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Mapbox  (account.mapbox.com -> Tokens)
# ---------------------------------------------------------------------------
# Public token, URL-restricted to your domains. Used by the browser for the pin map.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Secret token for server-side geocoding of responder home addresses (optional).
MAPBOX_SECRET_TOKEN=

# ---------------------------------------------------------------------------
# Scheduled dispatch job
# ---------------------------------------------------------------------------
# Shared secret that the pg_cron -> Edge Function call sends, so nothing else can advance
# the dispatch state machine.
DISPATCH_TICK_SECRET=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Who hears about an unmatched request is NOT an environment variable. It is the
# `contact.admin_phones` setting in the database, editable at /admin/settings, because the
# people on call change more often than deployments do.
#
#     select value from app_settings where key = 'contact.admin_phones';
#
# It is an empty list until somebody fills it in, and an empty list means nobody is told when a
# request goes twenty-five minutes without a volunteer.

# Set to "1" to send SMS to the console instead of Twilio. Use this until 10DLC is approved.
SMS_DRY_RUN=1

# ---------------------------------------------------------------------------
# what3words (optional)
# ---------------------------------------------------------------------------
# Free tier at developer.what3words.com. Without it, the /request paste field tells people to
# use GPS or the map pin instead of silently dropping a what3words address.
W3W_API_KEY=

# ---------------------------------------------------------------------------
# Error tracking (optional)
# ---------------------------------------------------------------------------
# Leave every one of these empty and the SDK never initialises: no requests, no overhead, and
# the app behaves exactly as it did before error tracking existed. That is the state locally and
# in CI, and it is checked -- the production build completes with no environment at all.
#
# The DSN is not a secret. It is shipped to every browser by design; it identifies a project to
# send to and grants nothing.
#
# Nothing about a person reaches Sentry: sendDefaultPii is off, session replay and performance
# tracing are off, and every event goes through src/lib/observability/scrub.ts first, which
# redacts phone numbers, coordinates, emails, keys and the /r/<token> recovery link. There are
# eighteen tests for that scrubber; read them before changing it.
NEXT_PUBLIC_SENTRY_DSN=

# Build-time only, for uploading source maps so a stack trace names a line of TypeScript. Absent
# locally and in CI, where nothing is uploaded and the build is unchanged. The auth token IS a
# secret -- set it in Vercel, never in a file that gets committed.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Web push (optional)
# ---------------------------------------------------------------------------
# Leave these empty and push is off: nothing is sent, the queued deliveries stay queued rather
# than being burned, and a member who turns it on later still gets the backlog within its retry
# window. That is the state locally and in CI.
#
# Generate a pair once, and only once -- rotating them silently invalidates every subscription
# already registered, and every member has to opt in again:
#
#     npm run push:keys
#
# The PUBLIC key is shipped to the browser by design; it is what a subscription is bound to and
# it grants nothing. The PRIVATE key signs the requests to Apple, Google and Mozilla that say a
# push really came from this app. It IS a secret -- set it in Vercel, never in a committed file.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Where a push service should complain if this app misbehaves. A mailto: for the operators, not
# for a member. Defaults to mailto:help@winch-up.com when unset.
VAPID_SUBJECT=
